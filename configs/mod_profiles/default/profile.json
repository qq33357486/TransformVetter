{
  "ai": {
    "provider": "openai",
    "base_url": "http://127.0.0.1:3000/v1",
    "model": "glm-flash",
    "api_key_env": "MODERATION_API_KEY",
    "timeout": 30,
    "max_retries": 1
  },
  "prompt": {
    "template_file": "ai_prompt.txt",
    "max_text_length": 30000
  },
  "probability": {
    "ai_review_rate": 0.05,
    "random_seed": 42,
    "low_risk_threshold": 0.6,
    "high_risk_threshold": 0.8,
    "enable_concurrency_limit_fallback": true
  },
  "local_model_type": "hashlinear",
  "hashlinear_training": {
    "min_samples": 30,
    "retrain_interval_minutes": 720,
    "max_samples": 10000,
    "max_db_items": 100000,
    "sample_loading": "random_duplicate",
    "analyzer": "char",
    "ngram_range": [
      2,
      4
    ],
    "n_features": 1048576,
    "alpha": 1e-05,
    "epochs": 2,
    "batch_size": 2048,
    "max_seconds": 300
  },
  "oneclass": {
    "block_threshold": -0.0001374208222841844,
    "divert_threshold": -0.001402411242132043,
    "review_base_rate": 1.0,
    "review_forced_model_prefixes": [],
    "review_violation_block_conf": 0.85,
    "review_cleared_gray_conf": 0.8,
    "review_unparseable_policy": "self",
    "baselines": []
  }
}