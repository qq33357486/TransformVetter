/configs/mod_profiles/*/history.db*
/configs/mod_profiles/*/*.pkl
/configs/mod_profiles/*/hashlinear_coef.f32
/configs/mod_profiles/*/fasttext*.bin
/configs/mod_profiles/*/.train_status.json
/run/
/logs/
*.log
configs/mod_profiles/scheduler-*/
